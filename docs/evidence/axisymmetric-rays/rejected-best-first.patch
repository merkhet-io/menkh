+// Best-first union evaluation: cached outer intervals only order/prune work.
+// Only original pose intersections remove material, preserving fixed semantics.
+const Candidate = struct { index: u32, span: Interval, gain: f64 };
+fn gain(material: []const Interval, span: Interval) f64 {
+    var amount: f64 = 0;
+    for (material) |m| {
+        if (m.lo >= span.hi) break;
+        amount += @max(0, @min(m.hi, span.hi) - @max(m.lo, span.lo));
+    }
+    return amount;
+}
+fn push(queue: *std.ArrayList(Candidate), candidate: Candidate) void {
+    var i = queue.items.len;
+    queue.appendAssumeCapacity(candidate);
+    while (i > 0) {
+        const parent = (i - 1) / 2;
+        if (queue.items[parent].gain >= candidate.gain) break;
+        queue.items[i] = queue.items[parent];
+        i = parent;
+    }
+    queue.items[i] = candidate;
+}
+fn pop(queue: *std.ArrayList(Candidate)) Candidate {
+    const result = queue.items[0];
+    const last = queue.pop().?;
+    if (queue.items.len == 0) return result;
+    var i: usize = 0;
+    while (i * 2 + 1 < queue.items.len) {
+        var child = i * 2 + 1;
+        if (child + 1 < queue.items.len and queue.items[child + 1].gain > queue.items[child].gain) child += 1;
+        if (last.gain >= queue.items[child].gain) break;
+        queue.items[i] = queue.items[child];
+        i = child;
+    }
+    queue.items[i] = last;
+    return result;
+}
+fn enqueue(tree: Tree, index: u32, x: f64, y: f64, material: []const Interval, queue: *std.ArrayList(Candidate), work: *Work) !void {
+    work.node_tests += 1;
+    const node = tree.nodes.items[index];
+    if (x < node.bounds.lo[0] or x > node.bounds.hi[0] or y < node.bounds.lo[1] or y > node.bounds.hi[1]) return;
+    var span = Interval{ .lo = node.bounds.lo[2], .hi = node.bounds.hi[2] };
+    if (!overlaps(material, span)) {
+        work.skipped_removed_nodes += 1;
+        return;
+    }
+    if (node.envelope_offset >= 0) {
+        var envelope = tree.poses[node.start];
+        envelope.offset = node.envelope_offset;
+        work.envelope_tests += 1;
+        span = (try ray(tree.profile, envelope, .{ x, y, 0 }, .{ 0, 0, 1 }, span)) orelse return;
+    }
+    const amount = gain(material, span);
+    if (amount <= 0) {
+        work.skipped_removed_nodes += 1;
+        return;
+    }
+    push(queue, .{ .index = index, .span = span, .gain = amount });
+}
+fn visitBest(tree: Tree, x: f64, y: f64, material: *std.ArrayList(Interval), queue: *std.ArrayList(Candidate), work: *Work) !void {
+    queue.clearRetainingCapacity();
+    try enqueue(tree, 0, x, y, material.items, queue, work);
+    while (queue.items.len > 0) {
+        const candidate = pop(queue);
+        if (!overlaps(material.items, candidate.span)) {
+            work.skipped_removed_nodes += 1;
+            continue;
+        }
+        const node = tree.nodes.items[candidate.index];
+        if (node.count == 0) {
+            try enqueue(tree, node.left, x, y, material.items, queue, work);
+            try enqueue(tree, node.right, x, y, material.items, queue, work);
+        } else for (tree.poses[node.start .. node.start + node.count]) |pose| {
+            if (material.items.len == 0) break;
+            if (x < pose.bounds.lo[0] or x > pose.bounds.hi[0] or y < pose.bounds.lo[1] or y > pose.bounds.hi[1]) continue;
+            const limits = Interval{ .lo = @max(material.items[0].lo, pose.bounds.lo[2]), .hi = @min(material.items[material.items.len - 1].hi, pose.bounds.hi[2]) };
+            if (limits.lo > limits.hi or !overlaps(material.items, limits)) continue;
+            work.ray_pose_tests += 1;
+            if (try ray(tree.profile, pose, .{ x, y, 0 }, .{ 0, 0, 1 }, limits)) |cut| {
+                work.cutting_intervals += 1;
+                subtractIntervals(material, cut);
+            }
+        }
+    }
+}
